# Copy to .env for local development. Never commit .env.

# MongoDB
DATABASE_URL=mongodb://localhost:27017/mukhar
PORT=3002

# Auth — use a long random value in production
JWT_SECRET=change-me
JWT_EXPIRES_IN=30d

# Push (optional): service-account JSON or a path to it
# FIREBASE_SERVICE_ACCOUNT=./firebase/your-adminsdk.json

# Country assumed for phone numbers typed without a country code
DEFAULT_PHONE_REGION=PK

# Image messages — Azure Blob Storage (private container)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_MEDIA_CONTAINER=media
# Largest photo/document allowed (bytes). The app reads this from the server.
# MEDIA_MAX_BYTES=10240000
